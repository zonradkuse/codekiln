// Generated by codekiln. Re-run `codekiln init [layers...]` to regenerate;
// manual edits are overwritten when you do.
{
  "name": "codekiln",
  "image": "__IMAGE__",
  "remoteUser": "ubuntu",

  // The egress firewall programs iptables inside the container.
  "capAdd": ["NET_ADMIN", "NET_RAW"],

  "mounts": [
    // Login, settings and history: one shared volume for every project.
    // For a separate login per project, append -${devcontainerId} to the volume name.
    "source=codekiln-state,target=/home/ubuntu/.claude,type=volume",
    // Shared skills from the host, read-only.
    "source=__SKILLS_DIR__,target=/etc/claude-code/.claude/skills,type=bind,readonly"
  ],

  // Apply the egress rules on every start, and make VS Code wait for them.
  "postStartCommand": { "egress-firewall": "sudo /usr/local/sbin/egress-firewall" },
  "waitFor": "postStartCommand",

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
