#!/usr/bin/env bash
# codekiln: sandboxed dev containers for coding agents.
#
#   codekiln layers                      list available language layers
#   codekiln build   [layers...] [docker build args]
#                                         build the base image, plus one image with
#                                         the given layers stacked on top
#   codekiln rebuild [docker build args] rebuild the base and every stack you have built
#   codekiln init    [dir] [layers...] [--profile <name|none>]
#                                         write the dev container config into a project
#                                         (run again with other layers/profile to switch)
#   codekiln open    [dir] [layers...] [--profile <name|none>]
#                                         init if needed, then open the project in VS Code
#   codekiln images                      list built images
#   codekiln allow   [hosts...]          allow HTTPS to more hosts (no args: list yours);
#                                         applied to running containers right away
#   codekiln disallow <hosts...>         remove hosts you allowed
#   codekiln profile [list]              list guideline profiles (bundled and yours)
#   codekiln profile install <name>      copy a bundled profile to yours (--force replaces it)
#   codekiln profile new <name> [--from <profile>]
#                                         start your own profile, empty or as a copy
#   codekiln profile default [name|none] show or set the profile new projects get
#   codekiln profile show [name]         print a profile (default: the default profile)
#   codekiln update                      pull the latest codekiln (then: codekiln rebuild)
#   codekiln paths                       show where codekiln keeps its files
#
# Examples:  codekiln build cpp arm mingw      codekiln open ~/code/app ts python
#            codekiln allow api.example.com    codekiln init ~/code/app --profile supervised-coding
# A name that matches a layer is a layer; write ./name for a directory of that name.
set -euo pipefail

# Locate the checkout this script belongs to, following symlinks (~/.local/bin).
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  here="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$here/$self"
done
ROOT="${CODEKILN_HOME:-$(cd -P "$(dirname "$self")/.." && pwd)}"

# Your own files live outside the checkout, so `update` never touches them.
CONFIG_DIR="${CODEKILN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/codekiln}"
SKILLS_DIR="${CODEKILN_SKILLS:-$CONFIG_DIR/skills}"
USER_LAYERS="$CONFIG_DIR/layers"
NETWORK_DIR="$CONFIG_DIR/network"          # mounted at /etc/codekiln/user
ALLOWLIST="$NETWORK_DIR/allowlist.txt"
USER_PROFILES="$CONFIG_DIR/profiles"       # <name>/AGENTS.md; a project's choice is
                                           # mounted at /etc/codekiln/guidelines
DEFAULT_PROFILE_FILE="$CONFIG_DIR/default-profile"
BUNDLED_ALLOWLIST="$ROOT/image/egress-allowlist.txt"
BUNDLED_PROFILES="$ROOT/profiles"

# Bump together with the marker in templates/devcontainer.json when the template
# changes, so `open` regenerates configs written by an older version.
TEMPLATE_MARK="(template 2)"
STATE_VOLUME="codekiln-state"

IMAGE="codekiln"
LEGACY_IMAGE="claude-devcontainer"   # configs written before the rename

die() { echo "codekiln: $*" >&2; exit 1; }

# Path of a layer script; your own layers win over the bundled ones.
layer_file() {
  if [[ -f $USER_LAYERS/$1.sh ]]; then echo "$USER_LAYERS/$1.sh"
  elif [[ -f $ROOT/layers/$1.sh ]]; then echo "$ROOT/layers/$1.sh"
  else return 1
  fi
}

available_layers() {
  local f
  for f in "$ROOT"/layers/*.sh "$USER_LAYERS"/*.sh; do
    [[ -e $f ]] && basename "$f" .sh
  done | sort -u
}

# Splits arguments into LAYERS (sorted, unique), DIR, PROFILE and DOCKER_ARGS.
parse_args() {
  LAYERS=(); DIR=""; DOCKER_ARGS=(); PROFILE=""
  local a
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    if [[ $a == --profile ]]; then
      [[ $# -gt 0 ]] || die "--profile needs a name (or none)"
      PROFILE="$1"; shift
    elif [[ $a == --profile=* ]]; then
      PROFILE="${a#--profile=}"
    elif [[ $a == -* ]]; then
      DOCKER_ARGS+=("$a")
    elif layer_file "$a" >/dev/null; then
      LAYERS+=("$a")
    elif [[ -d $a ]]; then
      [[ -z $DIR ]] || die "more than one directory given: $DIR and $a"
      DIR="$a"
    else
      die "'$a' is neither a layer nor a directory (layers: $(available_layers | tr '\n' ' '))"
    fi
  done
  if [[ ${#LAYERS[@]} -gt 0 ]]; then
    mapfile -t LAYERS < <(printf '%s\n' "${LAYERS[@]}" | sort -u)
  fi
}

# Image tag for a set of layers: "base", or the sorted names joined with "_".
tag_for() {
  if [[ $# -eq 0 ]]; then echo "base"; else local IFS=_; echo "$*"; fi
}

build_base() {
  docker build --pull -t "$IMAGE:base" "$@" "$ROOT/image"
}

# build_stack <layers...>   (docker args come from DOCKER_ARGS)
# Builds one image per prefix (cpp, cpp_ts, ...) so stacks share layers.
build_stack() {
  local prev="base" acc=() layer tag file
  for layer in "$@"; do
    acc+=("$layer")
    tag="$(tag_for "${acc[@]}")"
    file="$(layer_file "$layer")"
    echo "==> $IMAGE:$tag"
    docker build -f "$ROOT/image/Dockerfile.layer" \
      --build-arg "FROM_IMAGE=$IMAGE:$prev" --build-arg "LAYER=$layer" \
      -t "$IMAGE:$tag" ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"} "$(dirname "$file")"
    prev="$tag"
  done
}

cmd_layers() {
  local name file origin
  for name in $(available_layers); do
    file="$(layer_file "$name")"
    origin=""; [[ $file == "$USER_LAYERS"/* ]] && origin=" (yours)"
    printf '%-10s %s%s\n' "$name" "$(sed -n '1s/^# *//p' "$file")" "$origin"
  done
}

cmd_build() {
  parse_args "$@"
  [[ -z $DIR ]] || die "build takes layer names, not a directory"
  [[ -z $PROFILE ]] || die "build does not take --profile (profiles are chosen per project: codekiln init --profile)"
  build_base ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}
  build_stack ${LAYERS[@]+"${LAYERS[@]}"}
  echo "built $IMAGE:$(tag_for ${LAYERS[@]+"${LAYERS[@]}"})"
}

cmd_rebuild() {
  parse_args "$@"
  [[ -z $DIR && ${#LAYERS[@]} -eq 0 && -z $PROFILE ]] || die "rebuild takes only docker build args"
  local tags tag layers l ok
  mapfile -t tags < <(docker images --format '{{.Tag}}' "$IMAGE" | grep -vxE 'base|<none>' | sort -u || true)
  build_base ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}
  for tag in ${tags[@]+"${tags[@]}"}; do
    IFS=_ read -r -a layers <<<"$tag"
    ok=1
    for l in "${layers[@]}"; do
      layer_file "$l" >/dev/null || { echo "skipping $IMAGE:$tag (no layer '$l')" >&2; ok=0; }
    done
    [[ $ok -eq 1 ]] && build_stack "${layers[@]}"
  done
}

# Escapes '&' for the replacement side of ${var//pattern/replacement} (bash 5.2+).
repl_escape() { printf '%s' "${1//&/\\&}"; }

# Docker and Podman under SELinux deny a container access to host folders that do
# not carry the container_file_t type (what a ":z" mount would set, which the
# devcontainer mount syntax cannot express). Relabels only the given folders,
# which are codekiln's own; files created there later inherit the label.
selinux_label() {
  command -v selinuxenabled >/dev/null && selinuxenabled 2>/dev/null || return 0
  command -v chcon >/dev/null || return 0
  local d
  for d in "$@"; do
    [[ -d $d ]] || continue
    chcon -R -t container_file_t "$d" 2>/dev/null \
      || echo "warning: could not relabel $d for SELinux - containers may not be able to read it (try: chcon -R -t container_file_t '$d')" >&2
  done
}

# Tag currently configured in a project, or empty.
configured_tag() {
  sed -n -E "s/.*\"image\": *\"($IMAGE|$LEGACY_IMAGE):([^\"]*)\".*/\2/p" "$1" 2>/dev/null | head -n1
}

cmd_init() {
  parse_args "$@"
  [[ ${#DOCKER_ARGS[@]} -eq 0 ]] || die "unknown option: ${DOCKER_ARGS[0]}"
  local dir; dir="$(cd "${DIR:-.}" && pwd)"
  local target="$dir/.devcontainer/devcontainer.json"
  local tag; tag="$(tag_for ${LAYERS[@]+"${LAYERS[@]}"})"

  [[ ! -e $dir/.devcontainer.json ]] || die "$dir has its own .devcontainer.json - not touching it"
  local profile="$PROFILE"
  if [[ -e $target ]]; then
    local current; current="$(configured_tag "$target")"
    [[ -n $current ]] || die "$target was not created by codekiln - not overwriting"
    # No layers given: keep the stack the project already uses.
    if [[ ${#LAYERS[@]} -eq 0 ]]; then
      tag="$current"; [[ $tag == latest ]] && tag="base"
    fi
    # No --profile given: keep the profile the project already uses.
    [[ -n $profile ]] || profile="$(configured_profile "$target")"
  fi
  [[ -n $profile ]] || profile="$(default_profile)"
  [[ $profile == none ]] || ensure_profile "$profile"

  mkdir -p "$dir/.devcontainer" "$SKILLS_DIR" "$USER_PROFILES"
  ensure_allowlist
  selinux_label "$SKILLS_DIR" "$NETWORK_DIR" "$USER_PROFILES"

  local mount
  if [[ $profile == none ]]; then
    mount="$NO_PROFILE_MARK (codekiln init --profile <name> to add one)."
  else
    mount="// Guidelines profile \"$profile\", read-only (codekiln init --profile <name|none> to change)."
    mount+=$'\n    '"\"source=$USER_PROFILES/$profile,target=$GUIDELINES_TARGET,type=bind,readonly\","
  fi
  local content; content="$(<"$ROOT/templates/devcontainer.json")"
  content="${content//__IMAGE__/$IMAGE:$tag}"
  content="${content//__SKILLS_DIR__/$(repl_escape "$SKILLS_DIR")}"
  content="${content//__NETWORK_DIR__/$(repl_escape "$NETWORK_DIR")}"
  content="${content//__GUIDELINES_MOUNT__/$(repl_escape "$mount")}"
  printf '%s\n' "$content" >"$target"
  echo "wrote $target (image $IMAGE:$tag, profile $profile)"

  # Keep it out of the project's history without touching its .gitignore.
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    local exclude; exclude="$(git -C "$dir" rev-parse --git-path info/exclude)"
    [[ $exclude == /* ]] || exclude="$dir/$exclude"
    mkdir -p "$(dirname "$exclude")"
    if ! grep -qxF ".devcontainer/" "$exclude" 2>/dev/null; then
      echo ".devcontainer/" >>"$exclude"
    fi
  fi

  if ! docker image inspect "$IMAGE:$tag" >/dev/null 2>&1; then
    local hint="codekiln build"
    [[ $tag == base ]] || hint+=" ${tag//_/ }"
    echo "note: $IMAGE:$tag is not built yet - run: $hint"
  fi
}

cmd_open() {
  parse_args "$@"
  local dir; dir="$(cd "${DIR:-.}" && pwd)"
  local target="$dir/.devcontainer/devcontainer.json"
  if [[ ! -e $target || ${#LAYERS[@]} -gt 0 || -n $PROFILE ]] || ! grep -q "\"$IMAGE:" "$target"; then
    cmd_init "$@"
  elif ! grep -qF "$TEMPLATE_MARK" "$target"; then
    echo "config was written by an older codekiln - regenerating"
    cmd_init "$@"
    echo "note: use 'Rebuild Container' in VS Code to pick up the new mounts"
  fi
  # Again on every open: files moved into these folders keep their old label.
  selinux_label "$SKILLS_DIR" "$NETWORK_DIR" "$USER_PROFILES"
  local tag; tag="$(configured_tag "$target")"
  docker image inspect "$IMAGE:$tag" >/dev/null 2>&1 \
    || die "$IMAGE:$tag is not built yet - see the note above or run: codekiln build"
  command -v code >/dev/null || die "'code' not on PATH - open $dir in VS Code manually"
  code "$dir"
  echo "In VS Code: 'Reopen in Container' (after switching stacks or profiles: 'Rebuild Container')"
}

cmd_update() {
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "$ROOT is not a git checkout"
  git -C "$ROOT" pull --ff-only
  echo "now run: codekiln rebuild"
}

cmd_paths() {
  printf '%-16s %s\n' "program" "$ROOT" "your layers" "$USER_LAYERS" "your skills" "$SKILLS_DIR" \
    "your allowlist" "$ALLOWLIST" "your profiles" "$USER_PROFILES" "default profile" "$(default_profile)"
}

# --- network allowlist ----------------------------------------------------------

ensure_allowlist() {
  mkdir -p "$NETWORK_DIR"
  [[ -e $ALLOWLIST ]] && return
  cat >"$ALLOWLIST" <<'LIST'
# Your extra allowed hosts (HTTPS/443 only), on top of the bundled list.
# One host name or IPv4 address/network per line, '#' starts a comment.
# Manage with `codekiln allow <host>` / `codekiln disallow <host>`, or edit by
# hand. Mounted read-only into every container at /etc/codekiln/user/; in a
# running container, `codekiln allow` re-applies it, or run there:
#   sudo /usr/local/sbin/egress-firewall
LIST
}

# Entries of an allowlist file: comments and blanks stripped, lower-cased.
list_entries() {
  [[ -r $1 ]] || return 0
  sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$1" | tr '[:upper:]' '[:lower:]'
}

# Same checks as the firewall script, which skips anything that fails them.
is_valid_net() {
  local o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])'
  [[ $1 =~ ^$o\.$o\.$o\.$o(/([1-9]|[12][0-9]|3[0-2]))?$ ]]
}
is_domain() { [[ $1 =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]]; }

# Accepts a bare host or a pasted URL; prints the host or dies.
normalize_host() {
  local h="${1,,}"
  h="${h#*://}"
  # Strip a URL path, but keep the prefix of an address/network like 10.0.0.0/8.
  [[ $h =~ ^[0-9.]+/[0-9]+$ ]] || h="${h%%/*}"
  h="${h%%\?*}"; h="${h%%#*}"; h="${h##*@}"
  h="${h%:443}"; h="${h%.}"
  [[ $h != *:* ]] || die "'$1': only HTTPS on port 443 can be allowed"
  [[ $h != *'*'* ]] || die "'$1': wildcards are not supported (the firewall allows resolved addresses); list each host"
  is_domain "$h" || is_valid_net "$h" || die "'$1' is not a valid host name or IPv4 address/network"
  printf '%s\n' "$h"
}

# Re-runs the firewall in running codekiln containers (they all mount the state
# volume), so the change applies without a restart.
apply_allowlist() {
  local hint="in a running container: sudo /usr/local/sbin/egress-firewall"
  if ! command -v docker >/dev/null; then echo "applies on the next container start ($hint)"; return; fi
  local ids id name out
  mapfile -t ids < <(docker ps -q --filter "volume=$STATE_VOLUME" 2>/dev/null || true)
  if [[ ${#ids[@]} -eq 0 ]]; then echo "no running containers found - applies on the next start ($hint)"; return; fi
  for id in "${ids[@]}"; do
    name="$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null || echo "$id")"; name="${name#/}"
    if ! docker exec -u root "$id" test -e /etc/codekiln/user/allowlist.txt 2>/dev/null; then
      echo "$name: created from an older config - run 'codekiln init' in the project, then 'Rebuild Container'"
      continue
    fi
    if out="$(docker exec -u root "$id" /usr/local/sbin/egress-firewall 2>&1)"; then
      echo "$name: applied"
      grep -F "WARNING" <<<"$out" | sed 's/^/  /' || true
    else
      echo "$name: firewall update FAILED - all outbound traffic is blocked until it succeeds:"
      tail -n 5 <<<"$out" | sed 's/^/  /'
    fi
  done
}

cmd_allow() {
  ensure_allowlist
  local apply=1 a h hosts=() added=0
  for a in "$@"; do
    case $a in
      --no-apply) apply=0 ;;
      -*) die "unknown option: $a" ;;
      *) h="$(normalize_host "$a")" || exit 1; hosts+=("$h") ;;
    esac
  done

  if [[ ${#hosts[@]} -eq 0 ]]; then
    echo "your allowed hosts ($ALLOWLIST):"
    if [[ -n "$(list_entries "$ALLOWLIST")" ]]; then
      list_entries "$ALLOWLIST" | sed 's/^/  /'
    else
      echo "  (none)"
    fi
    echo "plus $(list_entries "$BUNDLED_ALLOWLIST" | wc -l | tr -d ' ') bundled hosts ($BUNDLED_ALLOWLIST)"
    return
  fi

  for h in "${hosts[@]}"; do
    if list_entries "$ALLOWLIST" | grep -qxF "$h"; then
      echo "already allowed: $h"
    elif list_entries "$BUNDLED_ALLOWLIST" | grep -qxF "$h"; then
      echo "already allowed by the bundled list: $h"
    else
      # Keep the new entry on its own line even if the file lacks a final newline.
      [[ ! -s $ALLOWLIST || -z "$(tail -c 1 "$ALLOWLIST")" ]] || echo >>"$ALLOWLIST"
      echo "$h" >>"$ALLOWLIST"
      echo "allowed: $h"
      added=$((added + 1))
    fi
  done
  if [[ $added -gt 0 && $apply -eq 1 ]]; then apply_allowlist; fi
}

cmd_disallow() {
  [[ $# -gt 0 ]] || die "usage: codekiln disallow <hosts...>"
  ensure_allowlist
  local a h hosts=() removed=0 tmp
  for a in "$@"; do
    [[ $a != -* ]] || die "unknown option: $a"
    h="$(normalize_host "$a")" || exit 1; hosts+=("$h")
  done
  for h in "${hosts[@]}"; do
    if list_entries "$ALLOWLIST" | grep -qxF "$h"; then
      tmp="$(mktemp "$NETWORK_DIR/.allowlist.XXXXXX")"
      # Drop lines whose entry (comment and blanks stripped) is this host.
      awk -v h="$h" '{ e = tolower($0); sub(/#.*/, "", e); gsub(/[[:space:]]/, "", e); if (e != h) print }' \
        "$ALLOWLIST" >"$tmp"
      chmod 0644 "$tmp"; mv "$tmp" "$ALLOWLIST"
      echo "removed: $h"
      removed=$((removed + 1))
    elif list_entries "$BUNDLED_ALLOWLIST" | grep -qxF "$h"; then
      echo "$h is on the bundled list - remove it from $BUNDLED_ALLOWLIST and run: codekiln rebuild"
    else
      echo "not on your list: $h"
    fi
  done
  if [[ $removed -gt 0 ]]; then apply_allowlist; fi
}

# --- guideline profiles ---------------------------------------------------------
# A profile is a folder with an AGENTS.md. Bundled ones live in the checkout;
# yours (installed copies and your own) in $USER_PROFILES, which is what gets
# mounted. Each project picks one at `init`; the default only decides what a
# project gets when it is first set up without --profile.

GUIDELINES_TARGET="/etc/codekiln/guidelines"
NO_PROFILE_MARK="// No guidelines profile"

valid_profile_name() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ && $1 != none ]]; }

default_profile() {
  local p=""
  [[ -r $DEFAULT_PROFILE_FILE ]] && p="$(tr -d '[:space:]' <"$DEFAULT_PROFILE_FILE")"
  echo "${p:-none}"
}

# Profile a project's config uses: a name, "none", or empty (older config).
configured_profile() {
  local src
  src="$(sed -n -E "s|.*\"source=([^,]*),target=$GUIDELINES_TARGET,.*|\1|p" "$1" 2>/dev/null | head -n1)"
  if [[ -n $src && $(dirname "$src") == "$USER_PROFILES" ]]; then
    basename "$src"
  elif grep -qF "$NO_PROFILE_MARK" "$1" 2>/dev/null; then
    echo none
  fi
}

# Makes sure $USER_PROFILES/<name> exists, installing the bundled one if needed.
ensure_profile() {
  valid_profile_name "$1" || die "'$1' is not a valid profile name (lower-case letters, digits, . _ -)"
  [[ -f $USER_PROFILES/$1/AGENTS.md ]] && return
  [[ -f $BUNDLED_PROFILES/$1/AGENTS.md ]] \
    || die "no profile '$1' (see: codekiln profile list; make one with: codekiln profile new $1)"
  install_profile "$1" 0
}

install_profile() {  # <name> <force>
  local src="$BUNDLED_PROFILES/$1/AGENTS.md" dest="$USER_PROFILES/$1/AGENTS.md"
  mkdir -p "$USER_PROFILES/$1"
  if [[ -e $dest ]]; then
    if cmp -s "$src" "$dest"; then echo "profile '$1' is already installed: $dest"; return; fi
    [[ $2 -eq 1 ]] || die "$dest already exists (perhaps with your edits) - add --force to replace it (it is kept as AGENTS.md.bak)"
    cp -p "$dest" "$dest.bak"
    echo "kept the previous file as $dest.bak"
  fi
  cp "$src" "$dest"
  echo "installed profile '$1': $dest (edit it to taste)"
}

profile_names() {
  local d
  for d in "$BUNDLED_PROFILES"/*/ "$USER_PROFILES"/*/; do
    [[ -f $d/AGENTS.md ]] && basename "$d"
  done | sort -u
}

cmd_profile() {
  local action="${1:-list}"
  [[ $# -eq 0 ]] || shift
  local name="" a
  case $action in
    list)
      local def notes
      def="$(default_profile)"
      for name in $(profile_names); do
        notes=()
        if [[ -f $USER_PROFILES/$name/AGENTS.md ]]; then
          if [[ -f $BUNDLED_PROFILES/$name/AGENTS.md ]]; then notes+=("installed"); else notes+=("yours"); fi
        else
          notes+=("bundled (not installed yet)")
        fi
        [[ $name == "$def" ]] && notes+=("default")
        printf '%-12s %s\n' "$name" "$(IFS=,; echo "${notes[*]}" | sed 's/,/, /g')"
      done
      echo "default for new projects: $def   (your profiles: $USER_PROFILES)"
      ;;
    install)
      local force=0
      for a in "$@"; do
        case $a in --force) force=1 ;; -*) die "unknown option: $a" ;; *) name="$a" ;; esac
      done
      [[ -n $name ]] || die "usage: codekiln profile install <name> [--force]  (see: codekiln profile list)"
      valid_profile_name "$name" && [[ -f $BUNDLED_PROFILES/$name/AGENTS.md ]] \
        || die "no bundled profile '$name' (see: codekiln profile list)"
      install_profile "$name" "$force"
      echo "use it with: codekiln init <project> --profile $name   (or for new projects: codekiln profile default $name)"
      ;;
    new)
      local from=""
      while [[ $# -gt 0 ]]; do
        case $1 in
          --from) [[ $# -ge 2 ]] || die "--from needs a profile name"; from="$2"; shift ;;
          --from=*) from="${1#--from=}" ;;
          -*) die "unknown option: $1" ;;
          *) name="$1" ;;
        esac
        shift
      done
      [[ -n $name ]] || die "usage: codekiln profile new <name> [--from <profile>]"
      valid_profile_name "$name" || die "'$name' is not a valid profile name (lower-case letters, digits, . _ -)"
      local dest="$USER_PROFILES/$name/AGENTS.md"
      [[ ! -e $dest ]] || die "$dest already exists"
      mkdir -p "$USER_PROFILES/$name"
      if [[ -n $from ]]; then
        local src="$USER_PROFILES/$from/AGENTS.md"
        [[ -f $src ]] || src="$BUNDLED_PROFILES/$from/AGENTS.md"
        valid_profile_name "$from" && [[ -f $src ]] || { rmdir "$USER_PROFILES/$name"; die "no profile '$from'"; }
        cp "$src" "$dest"
      else
        printf '# Guidelines (%s)\n\nInstructions for the agent in projects that use this profile.\n' "$name" >"$dest"
      fi
      echo "created $dest - edit it, then: codekiln init <project> --profile $name"
      ;;
    default)
      if [[ $# -eq 0 ]]; then default_profile; return; fi
      name="$1"
      [[ $name == none ]] || ensure_profile "$name"
      mkdir -p "$CONFIG_DIR"
      echo "$name" >"$DEFAULT_PROFILE_FILE"
      if [[ $name == none ]]; then
        echo "no default profile - projects set up from now on without --profile get none."
      else
        echo "default profile: $name - used by projects set up from now on without --profile."
      fi
      echo "Existing projects keep theirs; switch one with: codekiln init <project> --profile <name|none>"
      ;;
    show)
      name="${1:-$(default_profile)}"
      [[ $name != none ]] || die "no default profile set (see: codekiln profile list)"
      if [[ -f $USER_PROFILES/$name/AGENTS.md ]]; then cat "$USER_PROFILES/$name/AGENTS.md"
      elif valid_profile_name "$name" && [[ -f $BUNDLED_PROFILES/$name/AGENTS.md ]]; then cat "$BUNDLED_PROFILES/$name/AGENTS.md"
      else die "no profile '$name'"
      fi
      ;;
    *) die "usage: codekiln profile [list | install <name> [--force] | new <name> [--from <p>] | default [name|none] | show [name]]" ;;
  esac
}

case "${1:-}" in
  layers)  shift; cmd_layers ;;
  build)   shift; cmd_build "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  init)    shift; cmd_init "$@" ;;
  open)    shift; cmd_open "$@" ;;
  images)  docker images "$IMAGE" ;;
  allow)    shift; cmd_allow "$@" ;;
  disallow) shift; cmd_disallow "$@" ;;
  profile)  shift; cmd_profile "$@" ;;
  update)   cmd_update ;;
  paths)    cmd_paths ;;
  # Usage: the comment block at the top of this file.
  *)        awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"; exit 1 ;;
esac
