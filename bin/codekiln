#!/usr/bin/env bash
# codekiln: sandboxed dev containers for coding agents.
#
#   codekiln layers                      list available language layers
#   codekiln build   [layers...] [docker build args]
#                                         build the base image, plus one image with
#                                         the given layers stacked on top
#   codekiln rebuild [docker build args] rebuild the base and every stack you have built
#   codekiln init    [dir] [layers...]   write the dev container config into a project
#                                         (run again with other layers to switch stacks)
#   codekiln open    [dir] [layers...]   init if needed, then open the project in VS Code
#   codekiln images                      list built images
#   codekiln allow   [hosts...]          allow HTTPS to more hosts (no args: list yours);
#                                         applied to running containers right away
#   codekiln disallow <hosts...>         remove hosts you allowed
#   codekiln update                      pull the latest codekiln (then: codekiln rebuild)
#   codekiln paths                       show where codekiln keeps its files
#
# Examples:  codekiln build cpp arm mingw      codekiln open ~/code/app ts python
#            codekiln allow api.example.com
# A name that matches a layer is a layer; write ./name for a directory of that name.
set -euo pipefail

# Locate the checkout this script belongs to, following symlinks (~/.local/bin).
self="${BASH_SOURCE[0]}"
while [[ -L $self ]]; do
  here="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  [[ $self == /* ]] || self="$here/$self"
done
ROOT="${CODEKILN_HOME:-$(cd -P "$(dirname "$self")/.." && pwd)}"

# Your own files live outside the checkout, so `update` never touches them.
CONFIG_DIR="${CODEKILN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/codekiln}"
SKILLS_DIR="${CODEKILN_SKILLS:-$CONFIG_DIR/skills}"
USER_LAYERS="$CONFIG_DIR/layers"
NETWORK_DIR="$CONFIG_DIR/network"          # mounted at /etc/codekiln/user
ALLOWLIST="$NETWORK_DIR/allowlist.txt"
BUNDLED_ALLOWLIST="$ROOT/image/egress-allowlist.txt"

# Bump together with the marker in templates/devcontainer.json when the template
# changes, so `open` regenerates configs written by an older version.
TEMPLATE_MARK="(template 2)"
STATE_VOLUME="codekiln-state"

IMAGE="codekiln"
LEGACY_IMAGE="claude-devcontainer"   # configs written before the rename

die() { echo "codekiln: $*" >&2; exit 1; }

# Path of a layer script; your own layers win over the bundled ones.
layer_file() {
  if [[ -f $USER_LAYERS/$1.sh ]]; then echo "$USER_LAYERS/$1.sh"
  elif [[ -f $ROOT/layers/$1.sh ]]; then echo "$ROOT/layers/$1.sh"
  else return 1
  fi
}

available_layers() {
  local f
  for f in "$ROOT"/layers/*.sh "$USER_LAYERS"/*.sh; do
    [[ -e $f ]] && basename "$f" .sh
  done | sort -u
}

# Splits arguments into LAYERS (sorted, unique), DIR and DOCKER_ARGS.
parse_args() {
  LAYERS=(); DIR=""; DOCKER_ARGS=()
  local a
  for a in "$@"; do
    if [[ $a == -* ]]; then
      DOCKER_ARGS+=("$a")
    elif layer_file "$a" >/dev/null; then
      LAYERS+=("$a")
    elif [[ -d $a ]]; then
      [[ -z $DIR ]] || die "more than one directory given: $DIR and $a"
      DIR="$a"
    else
      die "'$a' is neither a layer nor a directory (layers: $(available_layers | tr '\n' ' '))"
    fi
  done
  if [[ ${#LAYERS[@]} -gt 0 ]]; then
    mapfile -t LAYERS < <(printf '%s\n' "${LAYERS[@]}" | sort -u)
  fi
}

# Image tag for a set of layers: "base", or the sorted names joined with "_".
tag_for() {
  if [[ $# -eq 0 ]]; then echo "base"; else local IFS=_; echo "$*"; fi
}

build_base() {
  docker build --pull -t "$IMAGE:base" "$@" "$ROOT/image"
}

# build_stack <layers...>   (docker args come from DOCKER_ARGS)
# Builds one image per prefix (cpp, cpp_ts, ...) so stacks share layers.
build_stack() {
  local prev="base" acc=() layer tag file
  for layer in "$@"; do
    acc+=("$layer")
    tag="$(tag_for "${acc[@]}")"
    file="$(layer_file "$layer")"
    echo "==> $IMAGE:$tag"
    docker build -f "$ROOT/image/Dockerfile.layer" \
      --build-arg "FROM_IMAGE=$IMAGE:$prev" --build-arg "LAYER=$layer" \
      -t "$IMAGE:$tag" ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"} "$(dirname "$file")"
    prev="$tag"
  done
}

cmd_layers() {
  local name file origin
  for name in $(available_layers); do
    file="$(layer_file "$name")"
    origin=""; [[ $file == "$USER_LAYERS"/* ]] && origin=" (yours)"
    printf '%-10s %s%s\n' "$name" "$(sed -n '1s/^# *//p' "$file")" "$origin"
  done
}

cmd_build() {
  parse_args "$@"
  [[ -z $DIR ]] || die "build takes layer names, not a directory"
  build_base ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}
  build_stack ${LAYERS[@]+"${LAYERS[@]}"}
  echo "built $IMAGE:$(tag_for ${LAYERS[@]+"${LAYERS[@]}"})"
}

cmd_rebuild() {
  parse_args "$@"
  [[ -z $DIR && ${#LAYERS[@]} -eq 0 ]] || die "rebuild takes only docker build args"
  local tags tag layers l ok
  mapfile -t tags < <(docker images --format '{{.Tag}}' "$IMAGE" | grep -vxE 'base|<none>' | sort -u || true)
  build_base ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}
  for tag in ${tags[@]+"${tags[@]}"}; do
    IFS=_ read -r -a layers <<<"$tag"
    ok=1
    for l in "${layers[@]}"; do
      layer_file "$l" >/dev/null || { echo "skipping $IMAGE:$tag (no layer '$l')" >&2; ok=0; }
    done
    [[ $ok -eq 1 ]] && build_stack "${layers[@]}"
  done
}

# Escapes '&' for the replacement side of ${var//pattern/replacement} (bash 5.2+).
repl_escape() { printf '%s' "${1//&/\\&}"; }

# Tag currently configured in a project, or empty.
configured_tag() {
  sed -n -E "s/.*\"image\": *\"($IMAGE|$LEGACY_IMAGE):([^\"]*)\".*/\2/p" "$1" 2>/dev/null | head -n1
}

cmd_init() {
  parse_args "$@"
  [[ ${#DOCKER_ARGS[@]} -eq 0 ]] || die "unknown option: ${DOCKER_ARGS[0]}"
  local dir; dir="$(cd "${DIR:-.}" && pwd)"
  local target="$dir/.devcontainer/devcontainer.json"
  local tag; tag="$(tag_for ${LAYERS[@]+"${LAYERS[@]}"})"

  [[ ! -e $dir/.devcontainer.json ]] || die "$dir has its own .devcontainer.json - not touching it"
  if [[ -e $target ]]; then
    local current; current="$(configured_tag "$target")"
    [[ -n $current ]] || die "$target was not created by codekiln - not overwriting"
    # No layers given: keep the stack the project already uses.
    if [[ ${#LAYERS[@]} -eq 0 ]]; then
      tag="$current"; [[ $tag == latest ]] && tag="base"
    fi
  fi

  mkdir -p "$dir/.devcontainer" "$SKILLS_DIR"
  ensure_allowlist
  local content; content="$(<"$ROOT/templates/devcontainer.json")"
  content="${content//__IMAGE__/$IMAGE:$tag}"
  content="${content//__SKILLS_DIR__/$(repl_escape "$SKILLS_DIR")}"
  content="${content//__NETWORK_DIR__/$(repl_escape "$NETWORK_DIR")}"
  printf '%s\n' "$content" >"$target"
  echo "wrote $target (image $IMAGE:$tag)"

  # Keep it out of the project's history without touching its .gitignore.
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    local exclude; exclude="$(git -C "$dir" rev-parse --git-path info/exclude)"
    [[ $exclude == /* ]] || exclude="$dir/$exclude"
    mkdir -p "$(dirname "$exclude")"
    if ! grep -qxF ".devcontainer/" "$exclude" 2>/dev/null; then
      echo ".devcontainer/" >>"$exclude"
    fi
  fi

  if ! docker image inspect "$IMAGE:$tag" >/dev/null 2>&1; then
    local hint="codekiln build"
    [[ $tag == base ]] || hint+=" ${tag//_/ }"
    echo "note: $IMAGE:$tag is not built yet - run: $hint"
  fi
}

cmd_open() {
  parse_args "$@"
  local dir; dir="$(cd "${DIR:-.}" && pwd)"
  local target="$dir/.devcontainer/devcontainer.json"
  if [[ ! -e $target || ${#LAYERS[@]} -gt 0 ]] || ! grep -q "\"$IMAGE:" "$target"; then
    cmd_init "$@"
  elif ! grep -qF "$TEMPLATE_MARK" "$target"; then
    echo "config was written by an older codekiln - regenerating"
    cmd_init "$@"
    echo "note: use 'Rebuild Container' in VS Code to pick up the new mounts"
  fi
  local tag; tag="$(configured_tag "$target")"
  docker image inspect "$IMAGE:$tag" >/dev/null 2>&1 \
    || die "$IMAGE:$tag is not built yet - see the note above or run: codekiln build"
  command -v code >/dev/null || die "'code' not on PATH - open $dir in VS Code manually"
  code "$dir"
  echo "In VS Code: 'Reopen in Container' (after switching stacks: 'Rebuild Container')"
}

cmd_update() {
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "$ROOT is not a git checkout"
  git -C "$ROOT" pull --ff-only
  echo "now run: codekiln rebuild"
}

cmd_paths() {
  printf '%-16s %s\n' "program" "$ROOT" "your layers" "$USER_LAYERS" "your skills" "$SKILLS_DIR" \
    "your allowlist" "$ALLOWLIST"
}

# --- network allowlist ----------------------------------------------------------

ensure_allowlist() {
  mkdir -p "$NETWORK_DIR"
  [[ -e $ALLOWLIST ]] && return
  cat >"$ALLOWLIST" <<'LIST'
# Your extra allowed hosts (HTTPS/443 only), on top of the bundled list.
# One host name or IPv4 address/network per line, '#' starts a comment.
# Manage with `codekiln allow <host>` / `codekiln disallow <host>`, or edit by
# hand. Mounted read-only into every container at /etc/codekiln/user/; in a
# running container, `codekiln allow` re-applies it, or run there:
#   sudo /usr/local/sbin/egress-firewall
LIST
}

# Entries of an allowlist file: comments and blanks stripped, lower-cased.
list_entries() {
  [[ -r $1 ]] || return 0
  sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$1" | tr '[:upper:]' '[:lower:]'
}

# Same checks as the firewall script, which skips anything that fails them.
is_valid_net() {
  local o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])'
  [[ $1 =~ ^$o\.$o\.$o\.$o(/([1-9]|[12][0-9]|3[0-2]))?$ ]]
}
is_domain() { [[ $1 =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]]; }

# Accepts a bare host or a pasted URL; prints the host or dies.
normalize_host() {
  local h="${1,,}"
  h="${h#*://}"
  # Strip a URL path, but keep the prefix of an address/network like 10.0.0.0/8.
  [[ $h =~ ^[0-9.]+/[0-9]+$ ]] || h="${h%%/*}"
  h="${h%%\?*}"; h="${h%%#*}"; h="${h##*@}"
  h="${h%:443}"; h="${h%.}"
  [[ $h != *:* ]] || die "'$1': only HTTPS on port 443 can be allowed"
  [[ $h != *'*'* ]] || die "'$1': wildcards are not supported (the firewall allows resolved addresses); list each host"
  is_domain "$h" || is_valid_net "$h" || die "'$1' is not a valid host name or IPv4 address/network"
  printf '%s\n' "$h"
}

# Re-runs the firewall in running codekiln containers (they all mount the state
# volume), so the change applies without a restart.
apply_allowlist() {
  local hint="in a running container: sudo /usr/local/sbin/egress-firewall"
  if ! command -v docker >/dev/null; then echo "applies on the next container start ($hint)"; return; fi
  local ids id name out
  mapfile -t ids < <(docker ps -q --filter "volume=$STATE_VOLUME" 2>/dev/null || true)
  if [[ ${#ids[@]} -eq 0 ]]; then echo "no running containers found - applies on the next start ($hint)"; return; fi
  for id in "${ids[@]}"; do
    name="$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null || echo "$id")"; name="${name#/}"
    if ! docker exec -u root "$id" test -e /etc/codekiln/user/allowlist.txt 2>/dev/null; then
      echo "$name: created from an older config - run 'codekiln init' in the project, then 'Rebuild Container'"
      continue
    fi
    if out="$(docker exec -u root "$id" /usr/local/sbin/egress-firewall 2>&1)"; then
      echo "$name: applied"
      grep -F "WARNING" <<<"$out" | sed 's/^/  /' || true
    else
      echo "$name: firewall update FAILED - all outbound traffic is blocked until it succeeds:"
      tail -n 5 <<<"$out" | sed 's/^/  /'
    fi
  done
}

cmd_allow() {
  ensure_allowlist
  local apply=1 a h hosts=() added=0
  for a in "$@"; do
    case $a in
      --no-apply) apply=0 ;;
      -*) die "unknown option: $a" ;;
      *) h="$(normalize_host "$a")" || exit 1; hosts+=("$h") ;;
    esac
  done

  if [[ ${#hosts[@]} -eq 0 ]]; then
    echo "your allowed hosts ($ALLOWLIST):"
    if [[ -n "$(list_entries "$ALLOWLIST")" ]]; then
      list_entries "$ALLOWLIST" | sed 's/^/  /'
    else
      echo "  (none)"
    fi
    echo "plus $(list_entries "$BUNDLED_ALLOWLIST" | wc -l | tr -d ' ') bundled hosts ($BUNDLED_ALLOWLIST)"
    return
  fi

  for h in "${hosts[@]}"; do
    if list_entries "$ALLOWLIST" | grep -qxF "$h"; then
      echo "already allowed: $h"
    elif list_entries "$BUNDLED_ALLOWLIST" | grep -qxF "$h"; then
      echo "already allowed by the bundled list: $h"
    else
      # Keep the new entry on its own line even if the file lacks a final newline.
      [[ ! -s $ALLOWLIST || -z "$(tail -c 1 "$ALLOWLIST")" ]] || echo >>"$ALLOWLIST"
      echo "$h" >>"$ALLOWLIST"
      echo "allowed: $h"
      added=$((added + 1))
    fi
  done
  if [[ $added -gt 0 && $apply -eq 1 ]]; then apply_allowlist; fi
}

cmd_disallow() {
  [[ $# -gt 0 ]] || die "usage: codekiln disallow <hosts...>"
  ensure_allowlist
  local a h hosts=() removed=0 tmp
  for a in "$@"; do
    [[ $a != -* ]] || die "unknown option: $a"
    h="$(normalize_host "$a")" || exit 1; hosts+=("$h")
  done
  for h in "${hosts[@]}"; do
    if list_entries "$ALLOWLIST" | grep -qxF "$h"; then
      tmp="$(mktemp "$NETWORK_DIR/.allowlist.XXXXXX")"
      # Drop lines whose entry (comment and blanks stripped) is this host.
      awk -v h="$h" '{ e = tolower($0); sub(/#.*/, "", e); gsub(/[[:space:]]/, "", e); if (e != h) print }' \
        "$ALLOWLIST" >"$tmp"
      chmod 0644 "$tmp"; mv "$tmp" "$ALLOWLIST"
      echo "removed: $h"
      removed=$((removed + 1))
    elif list_entries "$BUNDLED_ALLOWLIST" | grep -qxF "$h"; then
      echo "$h is on the bundled list - remove it from $BUNDLED_ALLOWLIST and run: codekiln rebuild"
    else
      echo "not on your list: $h"
    fi
  done
  if [[ $removed -gt 0 ]]; then apply_allowlist; fi
}

case "${1:-}" in
  layers)  shift; cmd_layers ;;
  build)   shift; cmd_build "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  init)    shift; cmd_init "$@" ;;
  open)    shift; cmd_open "$@" ;;
  images)  docker images "$IMAGE" ;;
  allow)    shift; cmd_allow "$@" ;;
  disallow) shift; cmd_disallow "$@" ;;
  update)   cmd_update ;;
  paths)    cmd_paths ;;
  # Usage: the comment block at the top of this file.
  *)        awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"; exit 1 ;;
esac
